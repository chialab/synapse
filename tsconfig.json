{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "lib": ["es2020", "dom"],
    "sourceMap": true,
    "inlineSources": true,
    "strict": true,
    "rootDir": ".",
    "outDir": "./dist",
    "noEmit": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "strictPropertyInitialization": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "useDefineForClassFields": false,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@chialab/dna",
    "moduleResolution": "bundler",
    "paths": {
      "@chialab/synapse": ["./src/index.ts"]
    }
  },
  "include": ["src"]
}
